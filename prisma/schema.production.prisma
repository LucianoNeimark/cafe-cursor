// Prisma schema for persistent PostgreSQL deployments.
// Keep the models in sync with schema.prisma, which is used for local SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model EligibleUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  company        String?
  role           String?
  approvalStatus String    @default("approved")
  createdAt      DateTime  @default(now())
  hasClaimed     Boolean   @default(false)
  claimedAt      DateTime?
  emailSentAt    DateTime?
  credit         Credit?   @relation(fields: [creditId], references: [id])
  creditId       String?   @unique
}

model Credit {
  id         String        @id @default(cuid())
  code       String        @unique
  link       String        @unique
  isUsed     Boolean       @default(false)
  isTest     Boolean       @default(false)
  assignedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  assignedTo EligibleUser?
}
