# ===========================================
# Cafe Cursor - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Local database (SQLite)
DATABASE_URL="file:./dev.db"

# Production database (Supabase / Neon / other PostgreSQL provider)
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/database?sslmode=require"

# Resend Email Service (https://resend.com)
# Free tier: 3,000 emails/month
RESEND_API_KEY=""
FROM_EMAIL="Your Event <onboarding@resend.dev>"

# Admin Panel Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_password_here"

# Use a unique random value of at least 32 characters in production
SESSION_SECRET="replace_with_a_long_random_secret"
