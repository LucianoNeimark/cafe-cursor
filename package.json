{
  "name": "cafe-cursor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.mjs local && next build --webpack",
    "build:production": "node scripts/generate-prisma.mjs production && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:push:production": "prisma db push --schema prisma/schema.production.prisma",
    "db:seed": "node scripts/generate-prisma.mjs local && tsx prisma/seed.ts",
    "db:import": "node scripts/generate-prisma.mjs local && tsx prisma/import.ts",
    "db:import:production": "node scripts/generate-prisma.mjs production && tsx prisma/import.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:reset": "prisma db push --schema prisma/schema.prisma --force-reset && npm run db:seed",
    "postinstall": "node scripts/generate-prisma.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "dotenv": "^17.2.3",
    "geist": "1.3.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.16",
    "tsx": "4.23.12",
    "typescript": "5.7.2"
  }
}
